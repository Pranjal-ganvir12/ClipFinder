# ─── Environment ──────────────────────────────────────────────────────────────
CLIPFINDER_ENV=development  # development | production

# ─── Session Secret (REQUIRED for production) ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset in production, auth.py falls back to a weak derived default (insecure).
SESSION_SECRET=

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Turso Database (free tier) ──────────────────────────────────────────────
# Set BOTH to persist videos/segments across Render restarts.
# Leave unset for local dev (uses an ephemeral local SQLite file).
# Get these from: turso.tech dashboard
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
